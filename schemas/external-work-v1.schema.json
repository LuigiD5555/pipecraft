{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pipecraft.local/schemas/external-work-v1.schema.json",
  "title": "PipeCraft external-work v1 contract",
  "description": "Canonical external-work semantic, resource, fencing and replay definitions. Operational dispatch remains disabled until later gates.",
  "$defs": {
    "installation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "provider_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._/-]*$"
    },
    "work_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 192,
      "pattern": "^[A-Z][A-Z0-9_]*:[A-Za-z0-9._:-]+$"
    },
    "pipeline_run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 192
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "offer_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "claim_epoch": {
      "type": "integer",
      "minimum": 1
    },
    "leadership_epoch": {
      "type": "integer",
      "minimum": 1
    },
    "owner_token": {
      "type": "string",
      "minLength": 16,
      "maxLength": 512,
      "writeOnly": true,
      "x-sensitive": true
    },
    "operation_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "receipt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "snapshot_revision": {
      "type": "integer",
      "minimum": 0
    },
    "work_state": {
      "type": "string",
      "enum": [
        "QUEUED",
        "BLOCKED",
        "OFFERED",
        "CLAIMED",
        "RUNNING",
        "SUCCEEDED_VERIFIED",
        "DEFERRED",
        "NEEDS_HUMAN",
        "FAILED_RETRYABLE",
        "FAILED_FINAL",
        "CANCELLED",
        "UNCERTAIN",
        "LEASE_EXPIRED"
      ]
    },
    "offer_confirmation_result": {
      "type": "string",
      "enum": [
        "CONFIRMED",
        "STALE_OFFER",
        "STALE_SNAPSHOT",
        "POLICY_BLOCKED",
        "SOURCE_BUSY",
        "SCOPE_BUSY",
        "NOT_FOUND",
        "NO_PRIMARY",
        "RECONCILIATION_REQUIRED"
      ]
    },
    "verified_outcome_status": {
      "type": "string",
      "enum": [
        "SUCCEEDED_VERIFIED",
        "DEFERRED",
        "NEEDS_HUMAN",
        "FAILED_RETRYABLE",
        "FAILED_FINAL",
        "CANCELLED",
        "UNCERTAIN"
      ]
    },
    "semantic_error_code": {
      "type": "string",
      "enum": [
        "STALE_OFFER",
        "STALE_SNAPSHOT",
        "POLICY_BLOCKED",
        "SOURCE_BUSY",
        "SCOPE_BUSY",
        "NOT_FOUND",
        "NO_PRIMARY",
        "RECONCILIATION_REQUIRED",
        "BAD_RESOURCE_REQUEST",
        "RESOURCE_BUSY",
        "WORKER_CAPABILITY_UNAVAILABLE",
        "HEAVY_BACKFILL_RESERVED",
        "CAPACITY_BUSY"
      ]
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "utc_ms": {
      "type": "integer",
      "minimum": 0
    },
    "canonical_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "worker_capability": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "resource_share_mode": {
      "type": "string",
      "enum": [
        "SHARED",
        "EXCLUSIVE"
      ]
    },
    "resource_demand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_key",
        "points",
        "quantity",
        "share_mode",
        "limit"
      ],
      "properties": {
        "resource_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
        },
        "points": {
          "type": "integer",
          "minimum": 1
        },
        "quantity": {
          "type": "integer",
          "minimum": 1
        },
        "share_mode": {
          "$ref": "#/$defs/resource_share_mode"
        },
        "limit": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "leader_fence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "installation_id",
        "leadership_epoch",
        "coordinator_id",
        "lease_until_ms"
      ],
      "properties": {
        "installation_id": {
          "$ref": "#/$defs/installation_id"
        },
        "leadership_epoch": {
          "$ref": "#/$defs/leadership_epoch"
        },
        "coordinator_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "lease_until_ms": {
          "$ref": "#/$defs/utc_ms"
        }
      }
    },
    "claim_fence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_id",
        "attempt_id",
        "claim_epoch",
        "leadership_epoch",
        "owner_token",
        "lease_until_ms"
      ],
      "properties": {
        "work_id": {
          "$ref": "#/$defs/work_id"
        },
        "attempt_id": {
          "$ref": "#/$defs/attempt_id"
        },
        "claim_epoch": {
          "$ref": "#/$defs/claim_epoch"
        },
        "leadership_epoch": {
          "$ref": "#/$defs/leadership_epoch"
        },
        "owner_token": {
          "$ref": "#/$defs/owner_token"
        },
        "lease_until_ms": {
          "$ref": "#/$defs/utc_ms"
        }
      }
    },
    "replay_disposition": {
      "type": "string",
      "enum": [
        "SAFE_TO_REPLAY",
        "RECEIPT_ALREADY_COMMITTED",
        "RECONCILIATION_REQUIRED",
        "FORBIDDEN_UNCERTAIN",
        "STALE_FENCE"
      ]
    },
    "replay_guard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_id",
        "operation_key",
        "disposition"
      ],
      "properties": {
        "work_id": {
          "$ref": "#/$defs/work_id"
        },
        "operation_key": {
          "$ref": "#/$defs/operation_key"
        },
        "receipt_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/receipt_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "disposition": {
          "$ref": "#/$defs/replay_disposition"
        }
      }
    }
  }
}
