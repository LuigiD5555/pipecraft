+/// Load a pipeline from an already parsed value. This is the structured IPC
+/// entry point: callers do not need to materialize a temporary YAML pipeline.
+pub fn load_pipeline_value(raw: Value, source: &str) -> ConfigResult<PipelineDefinition> {
+    let path = PathBuf::from(source);
+    match raw {
+        Value::Mapping(_) => parse_pipeline_value(&raw, &path),
+        Value::Null => {
+            let empty = Value::Mapping(Default::default());
+            parse_pipeline_value(&empty, &path)
+        }
+        _ => Err(ConfigError::new(
+            format!("Pipeline root must be a mapping: {source}"),
+            "YAML_ROOT_ERROR",
+        )
+        .with_hint("The top level of a PipeCraft spec must be key/value pairs.")),
+    }
+}
